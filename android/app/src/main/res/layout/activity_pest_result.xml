<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/green_background"
	tools:context=".PestResultActivity">

	<com.google.android.material.card.MaterialCardView
		android:id="@+id/topBarCard"
		android:layout_width="0dp"
		android:layout_height="56dp"
		android:layout_margin="16dp"
		app:cardBackgroundColor="@color/green_surface"
		app:cardCornerRadius="18dp"
		app:cardElevation="2dp"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent">

		<androidx.constraintlayout.widget.ConstraintLayout
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:paddingHorizontal="16dp">

			<ImageView
				android:id="@+id/backButton"
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:contentDescription="@string/back_arrow_description"
				android:src="@android:drawable/ic_menu_revert"
				android:tint="@color/green_primary"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent" />

			<TextView
				android:id="@+id/pestResultTitle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Pest Damage Result"
				android:textColor="@color/green_text_primary"
				android:textSize="18sp"
				android:textStyle="bold"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent" />
		</androidx.constraintlayout.widget.ConstraintLayout>
	</com.google.android.material.card.MaterialCardView>

	<com.google.android.material.button.MaterialButton
		android:id="@+id/scanAgainButton"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="16dp"
		android:layout_marginEnd="16dp"
		android:layout_marginBottom="16dp"
		android:text="@string/scan_again"
		android:textColor="@color/green_on_primary"
		app:backgroundTint="@color/green_primary"
		app:cornerRadius="12dp"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent" />

	<androidx.core.widget.NestedScrollView
		android:id="@+id/pestScrollView"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:fillViewport="true"
		android:overScrollMode="never"
		app:layout_constraintBottom_toTopOf="@id/scanAgainButton"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/topBarCard">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingBottom="16dp">

			<FrameLayout
				android:layout_width="match_parent"
				android:layout_height="200dp">

				<ImageView
					android:id="@+id/capturedLeafImage"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:contentDescription="@string/prediction_result"
					android:scaleType="centerCrop"
					android:src="@android:drawable/ic_menu_gallery"
					tools:src="@android:drawable/ic_menu_gallery" />

				<View
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:background="@drawable/result_hero_gradient" />
			</FrameLayout>

			<com.google.android.material.card.MaterialCardView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="16dp"
				android:layout_marginTop="16dp"
				android:layout_marginEnd="16dp"
				app:cardBackgroundColor="@color/green_surface"
				app:cardCornerRadius="12dp"
				app:cardElevation="2dp">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:padding="16dp">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Pest Damage Detected"
						android:textColor="@color/green_text_primary"
						android:textSize="22sp"
						android:textStyle="bold" />

					<TextView
						android:id="@+id/confidenceText"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:text="Confidence: --%"
						android:textColor="@color/green_text_secondary"
						android:textSize="15sp" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>

			<com.google.android.material.card.MaterialCardView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="16dp"
				android:layout_marginTop="16dp"
				android:layout_marginEnd="16dp"
				app:cardBackgroundColor="@color/green_surface"
				app:cardCornerRadius="12dp"
				app:cardElevation="2dp">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:padding="16dp">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="What does the damage look like?"
						android:textColor="@color/green_text_primary"
						android:textSize="16sp"
						android:textStyle="bold" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:text="Pick the closest match to get targeted guidance."
						android:textColor="@color/green_text_secondary"
						android:textSize="13sp" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/categoryChewingHoles"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:text="Holes or chewed edges"
						app:cornerRadius="10dp"
						style="@style/Widget.Material3.Button.OutlinedButton" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/categoryStipplingYellowing"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:text="Tiny pale specks or yellowing"
						app:cornerRadius="10dp"
						style="@style/Widget.Material3.Button.OutlinedButton" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/categoryWebbingCurling"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:text="Webbing or curled leaves"
						app:cornerRadius="10dp"
						style="@style/Widget.Material3.Button.OutlinedButton" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/categoryMiningTrails"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:text="Winding trails inside the leaf"
						app:cornerRadius="10dp"
						style="@style/Widget.Material3.Button.OutlinedButton" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/skipQuestionnaireButton"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:text="Skip - show general guidance"
						app:cornerRadius="10dp"
						style="@style/Widget.Material3.Button.TextButton" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>

			<com.google.android.material.card.MaterialCardView
				android:id="@+id/guidanceCard"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="16dp"
				android:layout_marginTop="16dp"
				android:layout_marginEnd="16dp"
				android:visibility="gone"
				app:cardBackgroundColor="@color/green_surface"
				app:cardCornerRadius="12dp"
				app:cardElevation="2dp">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:padding="16dp">

					<TextView
						android:id="@+id/guidanceTitle"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Guidance"
						android:textColor="@color/green_text_primary"
						android:textSize="18sp"
						android:textStyle="bold" />

					<TextView
						android:id="@+id/guidanceSymptoms"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:textColor="@color/green_text_secondary"
						android:textSize="14sp" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:text="Common pests"
						android:textColor="@color/green_text_primary"
						android:textSize="14sp"
						android:textStyle="bold" />

					<TextView
						android:id="@+id/guidancePests"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:textColor="@color/green_text_secondary"
						android:textSize="14sp" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:text="Chemical Treatment"
						android:textColor="@color/green_text_primary"
						android:textSize="14sp"
						android:textStyle="bold" />

					<TextView
						android:id="@+id/chemicalTreatmentText"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:textColor="@color/green_text_secondary"
						android:textSize="14sp" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:text="Organic Treatment"
						android:textColor="@color/green_text_primary"
						android:textSize="14sp"
						android:textStyle="bold" />

					<TextView
						android:id="@+id/organicTreatmentText"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:textColor="@color/green_text_secondary"
						android:textSize="14sp" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:text="Prevention"
						android:textColor="@color/green_text_primary"
						android:textSize="14sp"
						android:textStyle="bold" />

					<TextView
						android:id="@+id/preventionText"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:textColor="@color/green_text_secondary"
						android:textSize="14sp" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

