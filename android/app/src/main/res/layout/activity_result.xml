<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/green_background"
	tools:context=".ResultActivity">

	<androidx.core.widget.NestedScrollView
		android:id="@+id/resultScrollView"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:fillViewport="true"
		android:overScrollMode="never"
		app:layout_constraintBottom_toTopOf="@id/scanAgainButton"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<FrameLayout
				android:layout_width="match_parent"
				android:layout_height="200dp">

				<ImageView
					android:id="@+id/capturedLeafImage"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:adjustViewBounds="false"
					android:contentDescription="@string/prediction_result"
					android:scaleType="centerCrop"
					android:src="@android:drawable/ic_menu_gallery"
					android:tint="@android:color/transparent"
					tools:src="@android:drawable/ic_menu_gallery" />

				<View
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:background="@drawable/result_hero_gradient" />
			</FrameLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingBottom="16dp">

				<com.google.android.material.card.MaterialCardView
					android:id="@+id/detectionResultCard"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginStart="16dp"
					android:layout_marginTop="16dp"
					android:layout_marginEnd="16dp"
					app:cardBackgroundColor="@color/green_surface"
					app:cardCornerRadius="12dp"
					app:cardElevation="2dp">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:padding="16dp">

						<TextView
							android:id="@+id/diseaseNameText"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/disease_detection_result"
							android:textColor="@color/green_text_primary"
							android:textSize="22sp"
							android:textStyle="bold" />

						<TextView
							android:id="@+id/cropTypeText"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="4dp"
							android:text="@string/crop_type_placeholder"
							android:textColor="@color/green_text_secondary"
							android:textSize="14sp" />

						<ProgressBar
							android:id="@+id/confidenceProgress"
							style="?android:attr/progressBarStyleHorizontal"
							android:layout_width="match_parent"
							android:layout_height="8dp"
							android:layout_marginTop="16dp"
							android:max="100"
							android:progress="94"
							android:progressDrawable="@drawable/result_confidence_progress"
							android:progressTint="@color/green_primary"
							android:splitTrack="false" />

						<TextView
							android:id="@+id/confidenceText"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="10dp"
							android:text="@string/confidence_percent"
							android:textColor="@color/green_text_primary"
							android:textSize="15sp"
							android:textStyle="bold" />

						<TextView
							android:id="@+id/resultBadge"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="12dp"
							android:background="@drawable/badge_green"
							android:paddingHorizontal="14dp"
							android:paddingVertical="8dp"
							android:text="@string/healthy_label"
							android:textColor="@color/green_primary_variant"
							android:textSize="13sp"
							android:textStyle="bold" />
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>

				<com.google.android.material.card.MaterialCardView
					android:id="@+id/stageCard"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginStart="16dp"
					android:layout_marginTop="16dp"
					android:layout_marginEnd="16dp"
					app:cardBackgroundColor="@color/green_surface"
					app:cardCornerRadius="12dp"
					app:cardElevation="2dp">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:padding="16dp">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/severity_stage_title"
							android:textColor="@color/green_text_primary"
							android:textSize="18sp"
							android:textStyle="bold" />

						<LinearLayout
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="16dp"
							android:orientation="horizontal"
							android:weightSum="3">

							<LinearLayout
								android:id="@+id/stageContainer1"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:layout_weight="1"
								android:gravity="center"
								android:orientation="vertical">
								<View
									android:id="@+id/stageIndicator1"
									android:layout_width="match_parent"
									android:layout_height="8dp"
									android:layout_marginHorizontal="2dp"
									android:background="@drawable/stage_segment_background" />
								<TextView
									android:id="@+id/stageLabel1"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginTop="8dp"
									android:text="Stage 1"
									android:textSize="11sp"
									android:textColor="@color/green_text_secondary" />
							</LinearLayout>

							<LinearLayout
								android:id="@+id/stageContainer2"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:layout_weight="1"
								android:gravity="center"
								android:orientation="vertical">
								<View
									android:id="@+id/stageIndicator2"
									android:layout_width="match_parent"
									android:layout_height="8dp"
									android:layout_marginHorizontal="2dp"
									android:background="@drawable/stage_segment_background" />
								<TextView
									android:id="@+id/stageLabel2"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginTop="8dp"
									android:text="Stage 2"
									android:textSize="11sp"
									android:textColor="@color/green_text_secondary" />
							</LinearLayout>

							<LinearLayout
								android:id="@+id/stageContainer3"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:layout_weight="1"
								android:gravity="center"
								android:orientation="vertical">
								<View
									android:id="@+id/stageIndicator3"
									android:layout_width="match_parent"
									android:layout_height="8dp"
									android:layout_marginHorizontal="2dp"
									android:background="@drawable/stage_segment_background" />
								<TextView
									android:id="@+id/stageLabel3"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginTop="8dp"
									android:text="Stage 3"
									android:textSize="11sp"
									android:textColor="@color/green_text_secondary" />
							</LinearLayout>
						</LinearLayout>

						<TextView
							android:id="@+id/infectedAreaText"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="14dp"
							android:text="@string/infected_area_label"
							android:textColor="@color/green_text_secondary"
							android:textSize="14sp" />

						<TextView
							android:id="@+id/urgencyBadge"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="12dp"
							android:background="@drawable/badge_yellow"
							android:paddingHorizontal="14dp"
							android:paddingVertical="8dp"
							android:text="Treat within 3 days"
							android:textColor="#8A5A00"
							android:textSize="13sp"
							android:textStyle="bold" />
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>

				<com.google.android.material.card.MaterialCardView
					android:id="@+id/weatherCard"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginStart="16dp"
					android:layout_marginTop="16dp"
					android:layout_marginEnd="16dp"
					app:cardBackgroundColor="@color/green_surface"
					app:cardCornerRadius="12dp"
					app:cardElevation="2dp">

					<FrameLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content">

						<LinearLayout
							android:id="@+id/weatherContent"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:padding="16dp">

							<LinearLayout
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:orientation="horizontal">

								<TextView
									android:layout_width="0dp"
									android:layout_height="wrap_content"
									android:layout_weight="1"
									android:text="@string/seven_day_spread_prediction"
									android:textColor="@color/green_text_primary"
									android:textSize="18sp"
									android:textStyle="bold" />

								<TextView
									android:id="@+id/spreadRiskBadge"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:background="@drawable/badge_green"
									android:paddingHorizontal="14dp"
									android:paddingVertical="6dp"
									android:text="LOW"
									android:textColor="@color/green_primary_variant"
									android:textSize="13sp"
									android:textStyle="bold" />
							</LinearLayout>

							<androidx.constraintlayout.widget.ConstraintLayout
								android:layout_width="match_parent"
								android:layout_height="120dp"
								android:layout_marginTop="16dp">

								<View
									android:id="@+id/gaugeTrack"
									android:layout_width="200dp"
									android:layout_height="100dp"
									android:background="@drawable/gauge_background"
									app:layout_constraintBottom_toBottomOf="parent"
									app:layout_constraintEnd_toEndOf="parent"
									app:layout_constraintStart_toStartOf="parent" />

								<ImageView
									android:id="@+id/gaugeNeedle"
									android:layout_width="80dp"
									android:layout_height="80dp"
									android:src="@drawable/gauge_needle"
									android:rotation="-60"
									android:contentDescription="Risk gauge needle"
									app:layout_constraintBottom_toBottomOf="@id/gaugeTrack"
									app:layout_constraintEnd_toEndOf="@id/gaugeTrack"
									app:layout_constraintStart_toStartOf="@id/gaugeTrack"
									android:translationY="40dp" />

								<TextView
									android:id="@+id/gaugeValueText"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginBottom="8dp"
									android:text="LOW"
									android:textColor="@color/green_text_primary"
									android:textSize="14sp"
									android:textStyle="bold"
									app:layout_constraintBottom_toBottomOf="parent"
									app:layout_constraintEnd_toEndOf="parent"
									app:layout_constraintStart_toStartOf="parent" />
							</androidx.constraintlayout.widget.ConstraintLayout>

							<TextView
								android:id="@+id/spreadMessageText"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginTop="8dp"
								android:gravity="center"
								android:text="@string/weather_message"
								android:textColor="@color/green_text_secondary"
								android:textSize="13sp"
								android:lineSpacingExtra="3dp" />

							<HorizontalScrollView
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginTop="14dp"
								android:overScrollMode="never"
								android:scrollbars="none">

								<LinearLayout
									android:id="@+id/forecastRowContainer"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:orientation="horizontal" />
							</HorizontalScrollView>
						</LinearLayout>

						<View
							android:id="@+id/weatherShimmerOverlay"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:background="@drawable/shimmer_gradient"
							android:backgroundTint="#20000000"
							android:backgroundTintMode="src_over"
							android:visibility="gone" />
					</FrameLayout>
				</com.google.android.material.card.MaterialCardView>

				<com.google.android.material.card.MaterialCardView
					android:id="@+id/treatmentCard"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginStart="16dp"
					android:layout_marginTop="16dp"
					android:layout_marginEnd="16dp"
					app:cardBackgroundColor="@color/green_surface"
					app:cardCornerRadius="12dp"
					app:cardElevation="2dp">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:padding="16dp">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/treatment_plan"
							android:textColor="@color/green_text_primary"
							android:textSize="18sp"
							android:textStyle="bold" />

						<com.google.android.material.tabs.TabLayout
							android:id="@+id/treatmentTabs"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="12dp"
							app:tabIndicatorColor="@color/green_primary"
							app:tabSelectedTextColor="@color/green_primary"
							app:tabTextColor="@color/green_text_secondary"
							app:tabIndicatorHeight="3dp"
							app:tabIconTint="@color/green_primary">

							<com.google.android.material.tabs.TabItem
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:icon="@drawable/ic_chemical"
								android:text="@string/chemical_tab" />

							<com.google.android.material.tabs.TabItem
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:icon="@drawable/ic_organic"
								android:text="@string/organic_tab" />

							<com.google.android.material.tabs.TabItem
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:icon="@drawable/ic_prevention"
								android:text="@string/prevention_section_title" />
						</com.google.android.material.tabs.TabLayout>

						<LinearLayout
							android:id="@+id/treatmentStepsContainer"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="16dp"
							android:orientation="vertical" />
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>

				<com.google.android.material.card.MaterialCardView
					android:id="@+id/voiceCard"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginStart="16dp"
					android:layout_marginTop="16dp"
					android:layout_marginEnd="16dp"
					app:cardBackgroundColor="@color/green_surface"
					app:cardCornerRadius="12dp"
					app:cardElevation="2dp">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:padding="16dp">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/voice_advisory_title"
							android:textColor="@color/green_text_primary"
							android:textSize="18sp"
							android:textStyle="bold" />

						<com.google.android.material.button.MaterialButton
								android:id="@+id/voiceActionButton"
							android:layout_width="match_parent"
							android:layout_height="56dp"
							android:layout_marginTop="12dp"
							android:text="@string/listen_in_your_language"
							android:textAllCaps="false"
							android:textColor="@color/green_on_primary"
							app:cornerRadius="18dp"
							app:icon="@android:drawable/ic_btn_speak_now"
							app:iconGravity="textStart"
							app:iconTint="@color/green_on_primary"
							app:backgroundTint="@color/green_primary" />

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="14dp"
							android:text="@string/language_selector_label"
							android:textColor="@color/green_text_primary"
							android:textSize="14sp"
							android:textStyle="bold" />

						<Spinner
							android:id="@+id/languageSpinner"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="8dp"
							android:entries="@array/voice_language_entries"
							android:spinnerMode="dropdown" />
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
			</LinearLayout>
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>

	<com.google.android.material.button.MaterialButton
		android:id="@+id/scanAgainButton"
		android:layout_width="0dp"
		android:layout_height="56dp"
		android:layout_margin="16dp"
		android:text="@string/scan_again"
		android:textAllCaps="false"
		android:textColor="@color/green_on_primary"
		app:backgroundTint="@color/green_primary"
		app:cornerRadius="18dp"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
