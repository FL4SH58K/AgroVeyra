# AgroVeyra backend configuration.
# Copy this file to `.env` and fill in real values (backend/.env is git-ignored).

# IMPORTANT: create .env as UTF-8 WITHOUT a byte-order mark (BOM). A BOM on the
# first line prefixes the first variable name (e.g. "\ufeffOPENWEATHERMAP_API_KEY"),
# so os.getenv("OPENWEATHERMAP_API_KEY") silently returns empty and POST /weather
# answers "API key not configured" even though the key is present. This exact bug
# was caught by backend/test_backend.py; if that test's TEST 3 ever 500s with
# "not configured", the BOM is the first thing to check.

# Path to the disease TFLite model, relative to the backend/ working directory.
MODEL_PATH=models/agroveyra_model.tflite

# Path to the 60-class name list, in the same order the model outputs.
CLASS_NAMES_PATH=models/class_names.json

# OpenWeatherMap API key for POST /weather (32 hex chars). Leave empty to make
# /weather fail fast with HTTP 500 instead of returning an UNKNOWN spread_risk.
OPENWEATHERMAP_API_KEY=

# Below this top-1 probability, /predict flags the answer as low-confidence and
# returns a retake message instead of standing behind the diagnosis.
LOW_CONFIDENCE_THRESHOLD=0.95
